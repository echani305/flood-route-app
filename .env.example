# 이 파일을 .env 로 복사한 뒤 실제 키 값을 채워 넣으세요.
# .env 는 절대 git에 커밋하지 마세요 (.gitignore에 추가).

# data.go.kr 에서 발급받은 공공데이터포털 서비스키 (기상청 단기예보 API 등에서 공용으로 사용)
# ⚠️ 반드시 "일반 인증키(Decoding)" 버전을 넣으세요. (특수문자 /, +, = 가 그대로 보이는 형태)
#    "Encoding" 버전(%2F, %2B, %3D 포함)을 넣으면 서버에서 자동으로 다시 인코딩해서
#    이중 인코딩되어 SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 발생합니다.
DATA_GO_KR_SERVICE_KEY=여기에_디코딩된_인증키_입력

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키_입력

# 서버 포트
PORT=3000
